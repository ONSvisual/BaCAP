{
	"name": "bacap",
	"version": "3.0.0",
	"scripts": {
		"dev": "vite dev",
		"debug": "vite dev --debug",
		"build:preview": "vite build",
		"build": "cross-env APP_PATH=ons vite build && node ./scripts/js-fix",
		"buildgit": "vite build && cp -r build docs",
		"compress-data": "node ./scripts/compress-data",
		"start": "vite preview --outDir build",
		"deploy": "netlify build && netlify deploy -p",
		"push": "git add -A; git commit -m 'npm update';git push"
	},
	"devDependencies": {
		"@mapbox/mapbox-gl-draw": "^1.4.3",
		"@mapbox/tilebelt": "^1.0.2",
		"@mapbox/vector-tile": "^1.3.1",
		"@onsvisual/svelte-components": "^1.1.55",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.5.27",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@turf/area": "^6.5.0",
		"@turf/bbox": "^6.5.0",
		"@turf/bbox-polygon": "^6.5.0",
		"@turf/boolean-point-in-polygon": "^6.5.0",
		"@turf/buffer": "^6.5.0",
		"@turf/circle": "^6.5.0",
		"@turf/points-within-polygon": "^6.5.0",
		"@turf/simplify": "^6.5.0",
		"buffer": "^6.0.3",
		"compress-csv-to-json": "^0.0.3",
		"cross-env": "^10.1.0",
		"d3-dsv": "^3.0.1",
		"d3-format": "^3.1.0",
		"d3-scale": "^4.0.2",
		"flatbush": "^4.0.0",
		"html2canvas": "^1.4.1",
		"iconv-lite": "^0.6.3",
		"maplibre-gl": "^5.24.0",
		"mproj": "^0.0.35",
		"pbf": "^3.2.1",
		"pym.js": "^1.3.2",
		"svelte": "^5.0.0",
		"vite": "^5.4.4"
	},
	"type": "module",
	"engines": {
		"node": ">= 12.17.0"
	},
	"dependencies": {
		"@turf/difference": "^7.0.0",
		"@turf/helpers": "^7.0.0",
		"@turf/union": "^7.0.0",
		"d3-shape": "^3.2.0"
	}
}
